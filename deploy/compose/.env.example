# Nimino production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# The bootstrap script should generate this file for normal users.

# Immutable digest from a verified Nimino release set. Tags are not accepted.
NIMINO_IMAGE_DIGEST=sha256:CHANGE_ME_64_HEX

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
NIMINO_DOMAIN=nimino.example.com
RELAY_URL=wss://nimino.example.com
NIMINO_MEDIA_BASE_URL=https://nimino.example.com/media
NIMINO_MEDIA_SERVER_DOMAIN=nimino.example.com
NIMINO_CORS_ORIGINS=https://nimino.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
NIMINO_REQUIRE_AUTH_TOKEN=true
NIMINO_REQUIRE_RELAY_MEMBERSHIP=true
NIMINO_ALLOW_NIP_OA_AUTH=true
NIMINO_AUTO_MIGRATE=true
NIMINO_GIT_CONFORMANCE_PROBE=true
RUST_LOG=nimino_relay=info,nimino_db=info,nimino_auth=info,nimino_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
NIMINO_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
NIMINO_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=nimino
POSTGRES_USER=nimino
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
NIMINO_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
NIMINO_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
NIMINO_S3_BUCKET=nimino-media
# Bundled MinIO uses path-style URLs; deploy/compose/compose.yml pins this.
NIMINO_S3_ADDRESSING_STYLE=path

# Optional host ports. Base compose publishes the relay directly on NIMINO_HTTP_PORT.
NIMINO_HTTP_PORT=3000
# Chirps QUIC/mTLS. Place DER files at chirps/tls.crt, chirps/tls.key,
# and chirps/ca.crt; the private key must not be group/world-readable.
NIMINO_CHIRPS_PORT=7443
# Optional comma-separated host:port seeds for joining an existing cluster.
NIMINO_CHIRPS_SEEDS=
# Required authenticated peers before readiness succeeds (single-node: 0).
NIMINO_CLUSTER_MIN_PEERS=0

# Caddy host ports. Only used with compose.caddy.yml.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
