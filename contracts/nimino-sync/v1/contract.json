{
  "schemaVersion": 1,
  "contract": "nimino.sync",
  "version": 1,
  "compatibilityMode": false,
  "publicationState": "cutover-ready",
  "owner": "nimino-core",
  "module": "nim/nimino_core/src/nimino_core/domain/sync_protocol.nim",
  "dataContract": "nimino.data/v1",
  "transport": {
    "adapter": "nimino-chirps",
    "role": "opaque-bounded-frame-transport",
    "providesReplicationPolicy": false,
    "providesConflictPolicy": false
  },
  "frames": ["digest", "range-request", "range-batch", "cancel"],
  "scopeFields": [
    "protocol",
    "version",
    "sessionId",
    "communityId",
    "senderNodeId",
    "receiverNodeId"
  ],
  "bounds": {
    "maxRecords": 1000,
    "maxEncodedBytes": 1048576,
    "inflightBatches": 1,
    "sourceReadIsBounded": true,
    "slowPeerDeadline": "adapter-monotonic-ticks"
  },
  "digest": {
    "algorithm": "sha256",
    "encoding": "lowercase-hex",
    "adapter": "nimino-store.sync_digest",
    "adapterVerifiesCanonicalRange": true,
    "sameCheckpointMismatch": "fail-closed"
  },
  "resume": {
    "durableCheckpoint": "NodeStorePort.canonical_checkpoint",
    "prefixDigest": "recomputed-from-NodeStorePort.changes",
    "commit": "NodeStorePort.commit_canonical-exact-checkpoint",
    "advanceBeforeCommit": false,
    "duplicateFinalBatch": "idempotent-ack"
  },
  "communityIsolationEveryFrame": true,
  "conflictContract": "nimino.convergence/v1",
  "conflictResolutionOwner": 53,
  "scenarioHarnessOwner": 56,
  "legacyRemovalOwner": 12
}
