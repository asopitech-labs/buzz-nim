    {
      "name": "owner-mints-bounded-invite",
      "invariant": "Invite.Mint.AuthorityAndBounds",
      "input": {
        "decision": "invite",
        "request": {
          "command": "mint",
          "actorRole": "owner",
          "inviteState": "valid",
          "ttlSeconds": 3600,
          "maxUses": 5,
          "alreadyMember": false,
          "policyRequired": false,
          "policyAccepted": false
        }
      },
      "expected": {
        "decision": "invite",
        "action": "mint",
        "error": "none",
        "effectiveRole": "none"
      }
    },
