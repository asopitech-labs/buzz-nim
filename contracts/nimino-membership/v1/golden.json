{
  "schemaVersion": 1,
  "cases": [
    {
      "name": "open-channel-self-join",
      "invariant": "Channel.Join.Open",
      "input": {
        "decision": "channel",
        "request": {
          "command": "join",
          "visibility": "open",
          "actorRole": "none",
          "targetRole": "none",
          "requestedRole": "none",
          "actorIsTarget": true,
          "actorOwnsTargetAgent": false,
          "targetIsAgent": false,
          "targetAddPolicy": "anyone",
          "ownerCount": 1
        }
      },
      "expected": {
        "decision": "channel",
        "action": "insert",
        "error": "none",
        "effectiveRole": "member"
      }
    },
    {
      "name": "private-channel-self-join-denied",
      "invariant": "Channel.Join.InviteRequired",
      "input": {
        "decision": "channel",
        "request": {
          "command": "join",
          "visibility": "private",
          "actorRole": "none",
          "targetRole": "none",
          "requestedRole": "none",
          "actorIsTarget": true,
          "actorOwnsTargetAgent": false,
          "targetIsAgent": false,
          "targetAddPolicy": "anyone",
          "ownerCount": 1
        }
      },
      "expected": {
        "decision": "channel",
        "action": "reject",
        "error": "invite_required",
        "effectiveRole": "none"
      }
    },
    {
      "name": "last-owner-cannot-leave",
      "invariant": "Channel.LastOwner",
      "input": {
        "decision": "channel",
        "request": {
          "command": "leave",
          "visibility": "private",
          "actorRole": "owner",
          "targetRole": "owner",
          "requestedRole": "none",
          "actorIsTarget": true,
          "actorOwnsTargetAgent": false,
          "targetIsAgent": false,
          "targetAddPolicy": "anyone",
          "ownerCount": 1
        }
      },
      "expected": {
        "decision": "channel",
        "action": "reject",
        "error": "last_owner",
        "effectiveRole": "none"
      }
    },
    {
      "name": "member-removes-owned-agent",
      "invariant": "Channel.AgentOwner",
      "input": {
        "decision": "channel",
        "request": {
          "command": "remove",
          "visibility": "private",
          "actorRole": "member",
          "targetRole": "bot",
          "requestedRole": "none",
          "actorIsTarget": false,
          "actorOwnsTargetAgent": true,
          "targetIsAgent": true,
          "targetAddPolicy": "owner_only",
          "ownerCount": 1
        }
      },
      "expected": {
        "decision": "channel",
        "action": "remove",
        "error": "none",
        "effectiveRole": "bot"
      }
    },
    {
      "name": "nonmember-cannot-remove-owned-agent",
      "invariant": "Channel.AgentOwner.RequiresMembership",
      "input": {
        "decision": "channel",
        "request": {
          "command": "remove",
          "visibility": "private",
          "actorRole": "none",
          "targetRole": "bot",
          "requestedRole": "none",
          "actorIsTarget": false,
          "actorOwnsTargetAgent": true,
          "targetIsAgent": true,
          "targetAddPolicy": "owner_only",
          "ownerCount": 1
        }
      },
      "expected": {
        "decision": "channel",
        "action": "reject",
        "error": "not_authorized",
        "effectiveRole": "none"
      }
    },
    {
      "name": "ordinary-member-cannot-grant-admin",
      "invariant": "Channel.ElevatedGrant",
      "input": {
        "decision": "channel",
