{
  "schemaVersion": 1,
  "contract": "nimino.object-sync",
  "version": 1,
  "compatibilityMode": false,
  "publicationState": "cutover-ready",
  "owner": "nimino-core",
  "module": "nim/nimino_core/src/nimino_core/domain/object_sync_policy.nim",
  "byteAdapter": "crates/nimino-object-store",
  "syncContract": "nimino.sync/v1",
  "convergenceContract": "nimino.convergence/v1",
  "objectKinds": ["media", "git-pack", "git-manifest"],
  "manifest": {
    "contentAddress": "sha256-lowercase-hex",
    "digestVerifiedBeforePolicy": true,
    "maxObjectBytes": 68719476736
  },
  "fetch": {
    "modes": ["eager", "lazy"],
    "pinnedObjectsAlwaysFetched": true,
    "originSelection": "lexicographically-first-available-node",
    "maxFetchesPerPlan": 64,
    "missingOrigin": "typed-fail-closed"
  },
  "partialInstall": {
    "maxChunkBytes": 1048576,
    "resume": "durable-exact-offset",
    "verification": ["size", "sha256"],
    "install": "fsync-then-atomic-no-clobber",
    "overwrite": false
  },
  "gc": {
    "maxDeletesPerPlan": 1000,
    "requiresCrossCommunityReferenceSnapshot": true,
    "keeps": ["referenced", "pinned", "partial", "unverified", "inside-grace"]
  },
  "canonicalRecordTypes": ["object_manifest", "object_pin", "object_gc_watermark"],
  "repairOwner": 59,
  "legacyRemovalOwner": 12
}
