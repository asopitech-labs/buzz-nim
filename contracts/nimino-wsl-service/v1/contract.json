{
  "schemaVersion": 1,
  "contract": "nimino.wsl-service",
  "issue": 19,
  "platformContract": "wsl-support-v1",
  "serviceManager": "systemd-user",
  "unit": "nimino-relay.service",
  "releaseIdentity": "releaseSetId",
  "bundleContract": "nimino.wsl-bundle",
  "bundleInput": "verified-complete-bundle-only",
  "releaseLayout": "$XDG_DATA_HOME/nimino/service-releases/<releaseSetId>",
  "activation": "atomic-current-symlink",
  "healthGate": "systemctl-is-active",
  "rollback": "previous-current-target",
  "restartPolicy": "on-failure",
  "processOwnership": "control-group",
  "installedTools": [
    "nimino",
    "nimino-acp",
    "nimino-agent",
    "nimino-core-worker",
    "nimino-data-ops",
    "nimino-dev-mcp",
    "nimino-relay"
  ],
  "uninstallRetention": [
    "$XDG_DATA_HOME/nimino/data",
    "$XDG_STATE_HOME/nimino"
  ],
  "purgeRequiresExplicitFlag": true,
  "commands": ["install", "update", "restart", "uninstall"]
}
