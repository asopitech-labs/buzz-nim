{
  "schemaVersion": 1,
  "contract": "nimino.platform-release",
  "issue": 62,
  "releaseSetAuthority": "nimino.release-set",
  "compatibilityMode": false,
  "tagPrefix": "nimino-v",
  "sourceRepository": "asopitech-labs/nimino",
  "updaterEndpoint": "https://github.com/asopitech-labs/nimino/releases/download/nimino-desktop-latest/latest.json",
  "nativeWindows": false,
  "platforms": [
    {
