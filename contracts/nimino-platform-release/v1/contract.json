      "updaterKey": "darwin-aarch64",
      "requiredEnvironment": [
        "NIMINO_UPDATER_PUBLIC_KEY",
        "TAURI_SIGNING_PRIVATE_KEY",
        "NIMINO_APPLE_CERTIFICATE",
        "NIMINO_APPLE_CERTIFICATE_PASSWORD",
        "NIMINO_APPLE_SIGNING_IDENTITY",
        "NIMINO_APPLE_API_KEY_ID",
        "NIMINO_APPLE_API_ISSUER",
        "NIMINO_APPLE_API_KEY_P8"
      ],
      "artifacts": [
        {
          "role": "installer",
          "sourcePattern": "\\.dmg$",
          "fileName": "nimino-{version}-macos-aarch64.dmg",
          "signature": false
        },
        {
          "role": "updater",
          "sourcePattern": "\\.app\\.tar\\.gz$",
          "fileName": "nimino-{version}-macos-aarch64.app.tar.gz",
          "signature": true
        }
      ]
    },
    {
      "id": "macos-x86-64",
      "runner": "macos-15-intel",
      "target": "x86_64-apple-darwin",
      "updaterKey": "darwin-x86_64",
      "requiredEnvironment": [
        "NIMINO_UPDATER_PUBLIC_KEY",
        "TAURI_SIGNING_PRIVATE_KEY",
        "NIMINO_APPLE_CERTIFICATE",
        "NIMINO_APPLE_CERTIFICATE_PASSWORD",
        "NIMINO_APPLE_SIGNING_IDENTITY",
        "NIMINO_APPLE_API_KEY_ID",
        "NIMINO_APPLE_API_ISSUER",
        "NIMINO_APPLE_API_KEY_P8"
      ],
      "artifacts": [
        {
          "role": "installer",
          "sourcePattern": "\\.dmg$",
          "fileName": "nimino-{version}-macos-x86_64.dmg",
          "signature": false
        },
        {
          "role": "updater",
          "sourcePattern": "\\.app\\.tar\\.gz$",
          "fileName": "nimino-{version}-macos-x86_64.app.tar.gz",
          "signature": true
        }
      ]
    },
    {
      "id": "linux-x86-64",
      "runner": "ubuntu-24.04",
      "target": "x86_64-unknown-linux-gnu",
      "updaterKey": "linux-x86_64",
