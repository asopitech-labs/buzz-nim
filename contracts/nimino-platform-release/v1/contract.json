        "NIMINO_UPDATER_PUBLIC_KEY",
        "TAURI_SIGNING_PRIVATE_KEY"
      ],
      "artifacts": [
        {
          "role": "installer-updater",
          "sourcePattern": "\\.AppImage$",
          "fileName": "nimino-{version}-linux-x86_64.AppImage",
          "signature": true
        }
      ]
    }
  ],
  "wsl": {
    "id": "wsl2-x86_64",
    "runnerLabels": ["self-hosted", "linux", "x64", "nimino-wsl-ubuntu-24.04"],
