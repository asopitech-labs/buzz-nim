{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asopitech.com/nimino/contracts/nim-rust-boundary/v1/request.schema.json",
  "title": "NiminoBoundaryRequestV1",
  "$defs": {
    "eventVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["createdAt", "eventId"],
      "properties": {
        "createdAt": { "type": "integer" },
        "eventId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "threadMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootId", "depth"],
      "properties": {
        "rootId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "depth": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "threadParent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eventId", "createdAt", "channelId", "tags", "metadata"],
      "properties": {
        "eventId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "createdAt": { "type": "integer" },
        "channelId": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "#/$defs/tags" },
        "metadata": {
          "oneOf": [{ "$ref": "#/$defs/threadMetadata" }, { "type": "null" }]
        }
      }
    },
    "threadRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "createdAt",
        "channelId",
        "tags",
        "parent",
        "rootCreatedAt"
      ],
      "properties": {
        "eventId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "createdAt": { "type": "integer" },
        "channelId": { "type": "string", "minLength": 1 },
        "tags": { "$ref": "#/$defs/tags" },
        "parent": {
          "oneOf": [{ "$ref": "#/$defs/threadParent" }, { "type": "null" }]
        },
        "rootCreatedAt": {
          "oneOf": [{ "type": "integer" }, { "type": "null" }]
        }
      }
    },
    "deletionTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventId",
        "author",
        "createdAt",
        "active",
        "parentId",
        "rootId"
      ],
      "properties": {
        "eventId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "author": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "createdAt": { "type": "integer" },
        "active": { "type": "boolean" },
        "parentId": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            { "type": "null" }
          ]
        },
        "rootId": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "deletionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "createdAt", "eTargets", "aTargets", "target"],
      "properties": {
        "actor": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "createdAt": { "type": "integer" },
        "eTargets": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        },
        "aTargets": { "type": "array", "items": { "type": "string" } },
        "target": {
          "oneOf": [{ "$ref": "#/$defs/deletionTarget" }, { "type": "null" }]
        }
      }
    },
    "reactionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetExists", "activeDuplicate", "content", "tags"],
      "properties": {
        "targetExists": { "type": "boolean" },
        "activeDuplicate": { "type": "boolean" },
        "content": { "type": "string" },
        "tags": { "$ref": "#/$defs/tags" }
      }
    },
    "eventPolicyPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "kind", "dTagCount", "dTagLen"],
          "properties": {
            "decision": { "const": "classify" },
            "kind": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
            "dTagCount": { "type": "integer", "minimum": 0, "maximum": 65535 },
            "dTagLen": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "incoming", "current"],
          "properties": {
            "decision": { "const": "replacement" },
            "incoming": { "$ref": "#/$defs/eventVersion" },
            "current": {
              "oneOf": [{ "$ref": "#/$defs/eventVersion" }, { "type": "null" }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "thread" },
            "request": { "$ref": "#/$defs/threadRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "deletion" },
            "request": { "$ref": "#/$defs/deletionRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "reaction" },
            "request": { "$ref": "#/$defs/reactionRequest" }
          }
        }
      ]
    },
    "membershipRole": {
      "enum": ["none", "owner", "admin", "member", "guest", "bot"]
    },
    "membershipCommand": {
      "enum": ["join", "add", "change_role", "remove", "leave"]
    },
    "channelMembershipRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "visibility",
        "actorRole",
        "targetRole",
        "requestedRole",
        "actorIsTarget",
        "actorOwnsTargetAgent",
        "targetIsAgent",
        "targetAddPolicy",
        "ownerCount"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/membershipCommand" },
        "visibility": { "enum": ["open", "private"] },
        "actorRole": { "$ref": "#/$defs/membershipRole" },
        "targetRole": { "$ref": "#/$defs/membershipRole" },
        "requestedRole": { "$ref": "#/$defs/membershipRole" },
        "actorIsTarget": { "type": "boolean" },
        "actorOwnsTargetAgent": { "type": "boolean" },
        "targetIsAgent": { "type": "boolean" },
        "targetAddPolicy": { "enum": ["anyone", "owner_only", "nobody"] },
        "ownerCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 }
      }
    },
    "relayMembershipRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "actorRole",
        "targetRole",
        "requestedRole",
        "actorIsTarget"
      ],
      "properties": {
        "command": { "$ref": "#/$defs/membershipCommand" },
        "actorRole": { "$ref": "#/$defs/membershipRole" },
        "targetRole": { "$ref": "#/$defs/membershipRole" },
        "requestedRole": { "$ref": "#/$defs/membershipRole" },
        "actorIsTarget": { "type": "boolean" }
      }
    },
    "invitePolicyRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "actorRole",
        "inviteState",
        "ttlSeconds",
        "maxUses",
        "alreadyMember",
        "policyRequired",
        "policyAccepted"
      ],
      "properties": {
        "command": { "enum": ["mint", "claim"] },
        "actorRole": { "$ref": "#/$defs/membershipRole" },
        "inviteState": { "enum": ["valid", "expired", "exhausted", "invalid"] },
        "ttlSeconds": { "type": "integer" },
        "maxUses": {
          "oneOf": [
            { "type": "integer", "minimum": -2147483648, "maximum": 2147483647 },
            { "type": "null" }
          ]
        },
        "alreadyMember": { "type": "boolean" },
        "policyRequired": { "type": "boolean" },
        "policyAccepted": { "type": "boolean" }
      }
    },
    "ownershipTransferRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actorIsOperator",
        "ownerPresent",
        "expectedOwnerMatches",
        "newOwnerIsCurrentOwner",
        "newOwnerAtLimit"
      ],
      "properties": {
        "actorIsOperator": { "type": "boolean" },
        "ownerPresent": { "type": "boolean" },
        "expectedOwnerMatches": { "type": "boolean" },
        "newOwnerIsCurrentOwner": { "type": "boolean" },
        "newOwnerAtLimit": { "type": "boolean" }
      }
    },
    "membershipPolicyPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "channel" },
            "request": { "$ref": "#/$defs/channelMembershipRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "relay" },
            "request": { "$ref": "#/$defs/relayMembershipRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "invite" },
            "request": { "$ref": "#/$defs/invitePolicyRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "ownership_transfer" },
            "request": { "$ref": "#/$defs/ownershipTransferRequest" }
          }
        }
      ]
    },
    "dmMutationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "requestCommunity",
        "sourceCommunity",
        "destinationCommunity",
        "sourceExists",
        "sourceIsDm",
        "actorIsSourceParticipant",
        "sourceActorHidden",
        "actorIncluded",
        "participantCount",
        "newParticipantCount",
        "destinationExists",
        "destinationIsDm",
        "destinationActorHidden"
      ],
      "properties": {
        "command": { "enum": ["open", "add", "hide"] },
        "requestCommunity": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sourceCommunity": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "destinationCommunity": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "sourceExists": { "type": "boolean" },
        "sourceIsDm": { "type": "boolean" },
        "actorIsSourceParticipant": { "type": "boolean" },
        "sourceActorHidden": { "type": "boolean" },
        "actorIncluded": { "type": "boolean" },
        "participantCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "newParticipantCount": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
        "destinationExists": { "type": "boolean" },
        "destinationIsDm": { "type": "boolean" },
        "destinationActorHidden": { "type": "boolean" }
      }
    },
    "dmAccessRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "requestCommunity",
        "resourceCommunity",
        "resourceExists",
        "channelIsDm",
        "actorIsParticipant",
        "actorIsViewer"
      ],
      "properties": {
        "operation": { "enum": ["read", "write", "visibility"] },
        "requestCommunity": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "resourceCommunity": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        },
        "resourceExists": { "type": "boolean" },
        "channelIsDm": { "type": "boolean" },
        "actorIsParticipant": { "type": "boolean" },
        "actorIsViewer": { "type": "boolean" }
      }
    },
    "dmPolicyPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "mutation" },
            "request": { "$ref": "#/$defs/dmMutationRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "access" },
            "request": { "$ref": "#/$defs/dmAccessRequest" }
          }
        }
      ]
    },
    "boundaryUuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "nullableBoundaryUuid": {
      "oneOf": [{ "$ref": "#/$defs/boundaryUuid" }, { "type": "null" }]
    },
    "nonNegativeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "nullableSeconds": {
      "oneOf": [{ "$ref": "#/$defs/nonNegativeSeconds" }, { "type": "null" }]
    },
    "moderationReportRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestCommunity",
        "targetCommunity",
        "targetExists",
        "reporterIsTarget",
        "duplicate",
        "targetKind",
        "reportType"
      ],
      "properties": {
        "requestCommunity": { "$ref": "#/$defs/boundaryUuid" },
        "targetCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "targetExists": { "type": "boolean" },
        "reporterIsTarget": { "type": "boolean" },
        "duplicate": { "type": "boolean" },
        "targetKind": { "enum": ["event", "pubkey", "blob"] },
        "reportType": {
          "enum": [
            "illegal",
            "nudity",
            "malware",
            "spam",
            "impersonation",
            "profanity",
            "other"
          ]
        }
      }
    },
    "moderationRestrictionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "requestCommunity",
        "actorRoleCommunity",
        "targetRoleCommunity",
        "actorRestrictionCommunity",
        "targetRestrictionCommunity",
        "actorRole",
        "targetRole",
        "actorRestrictionExists",
        "actorBanSet",
        "actorBanExpiresAt",
        "targetRestrictionExists",
        "targetBanSet",
        "targetBanExpiresAt",
        "targetMutedUntil",
        "actorIsTarget",
        "createdAtSeconds",
        "nowSeconds",
        "requestedExpiresAt"
      ],
      "properties": {
        "command": { "enum": ["ban", "unban", "timeout", "untimeout"] },
        "requestCommunity": { "$ref": "#/$defs/boundaryUuid" },
        "actorRoleCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "targetRoleCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "actorRestrictionCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "targetRestrictionCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "actorRole": { "$ref": "#/$defs/membershipRole" },
        "targetRole": { "$ref": "#/$defs/membershipRole" },
        "actorRestrictionExists": { "type": "boolean" },
        "actorBanSet": { "type": "boolean" },
        "actorBanExpiresAt": { "$ref": "#/$defs/nullableSeconds" },
        "targetRestrictionExists": { "type": "boolean" },
        "targetBanSet": { "type": "boolean" },
        "targetBanExpiresAt": { "$ref": "#/$defs/nullableSeconds" },
        "targetMutedUntil": { "$ref": "#/$defs/nullableSeconds" },
        "actorIsTarget": { "type": "boolean" },
        "createdAtSeconds": { "$ref": "#/$defs/nonNegativeSeconds" },
        "nowSeconds": { "$ref": "#/$defs/nonNegativeSeconds" },
        "requestedExpiresAt": { "$ref": "#/$defs/nullableSeconds" }
      }
    },
    "moderationResolutionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestCommunity",
        "actorRoleCommunity",
        "actorRestrictionCommunity",
        "reportCommunity",
        "actorRole",
        "actorRestrictionExists",
        "actorBanSet",
        "actorBanExpiresAt",
        "reportExists",
        "reportOpen",
        "createdAtSeconds",
        "nowSeconds",
        "status",
        "action"
      ],
      "properties": {
        "requestCommunity": { "$ref": "#/$defs/boundaryUuid" },
        "actorRoleCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "actorRestrictionCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "reportCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "actorRole": { "$ref": "#/$defs/membershipRole" },
        "actorRestrictionExists": { "type": "boolean" },
        "actorBanSet": { "type": "boolean" },
        "actorBanExpiresAt": { "$ref": "#/$defs/nullableSeconds" },
        "reportExists": { "type": "boolean" },
        "reportOpen": { "type": "boolean" },
        "createdAtSeconds": { "$ref": "#/$defs/nonNegativeSeconds" },
        "nowSeconds": { "$ref": "#/$defs/nonNegativeSeconds" },
        "status": { "enum": ["resolved", "dismissed"] },
        "action": { "enum": ["delete", "kick", "ban", "timeout", "dismiss", "escalate"] }
      }
    },
    "moderationEnforcementRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "requestCommunity",
        "principalRestrictionCommunity",
        "ownerRestrictionCommunity",
        "principalRestrictionExists",
        "principalBanSet",
        "principalBanExpiresAt",
        "principalMutedUntil",
        "ownerAttested",
        "ownerRestrictionExists",
        "ownerBanSet",
        "ownerBanExpiresAt",
        "nowSeconds"
      ],
      "properties": {
        "operation": { "enum": ["authenticate", "write"] },
        "requestCommunity": { "$ref": "#/$defs/boundaryUuid" },
        "principalRestrictionCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "ownerRestrictionCommunity": { "$ref": "#/$defs/nullableBoundaryUuid" },
        "principalRestrictionExists": { "type": "boolean" },
        "principalBanSet": { "type": "boolean" },
        "principalBanExpiresAt": { "$ref": "#/$defs/nullableSeconds" },
        "principalMutedUntil": { "$ref": "#/$defs/nullableSeconds" },
        "ownerAttested": { "type": "boolean" },
        "ownerRestrictionExists": { "type": "boolean" },
        "ownerBanSet": { "type": "boolean" },
        "ownerBanExpiresAt": { "$ref": "#/$defs/nullableSeconds" },
        "nowSeconds": { "$ref": "#/$defs/nonNegativeSeconds" }
      }
    },
    "moderationPolicyPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "report" },
            "request": { "$ref": "#/$defs/moderationReportRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "restriction" },
            "request": { "$ref": "#/$defs/moderationRestrictionRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "resolution" },
            "request": { "$ref": "#/$defs/moderationResolutionRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "enforcement" },
            "request": { "$ref": "#/$defs/moderationEnforcementRequest" }
          }
        }
      ]
    },
    "communityLifecycleRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "state",
        "actorIsOperator",
        "actorIsOwner",
        "ownerProvided",
        "ownerAtLimit",
        "protectedDeployment"
      ],
      "properties": {
        "command": { "enum": ["create", "archive", "unarchive"] },
        "state": {
          "enum": ["missing", "active", "archived", "deleting", "deleted"]
        },
        "actorIsOperator": { "type": "boolean" },
        "actorIsOwner": { "type": "boolean" },
        "ownerProvided": { "type": "boolean" },
        "ownerAtLimit": { "type": "boolean" },
        "protectedDeployment": { "type": "boolean" }
      }
    },
    "communityScopeRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestCommunity", "resourceCommunity"],
      "properties": {
        "requestCommunity": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "resourceCommunity": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            { "type": "null" }
          ]
        }
      }
    },
    "communityPolicyPayload": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "lifecycle" },
            "request": { "$ref": "#/$defs/communityLifecycleRequest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "scope" },
            "request": { "$ref": "#/$defs/communityScopeRequest" }
          }
        }
      ]
    },
    "workflowValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "boolean" },
        { "type": "number" }
      ]
    },
    "workflowValueMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/workflowValue" }
    },
    "workflowAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "text", "channel", "replyInThread", "recipient", "topic",
        "emoji", "url", "httpMethod", "headers", "body", "approver",
        "message", "timeout", "duration"
      ],
      "properties": {
        "kind": {
          "enum": [
            "send_message", "send_dm", "set_channel_topic", "add_reaction",
            "call_webhook", "request_approval", "delay"
          ]
        },
        "text": { "type": "string" },
        "channel": { "type": "string" },
        "replyInThread": { "type": "boolean" },
        "recipient": { "type": "string" },
        "topic": { "type": "string" },
        "emoji": { "type": "string" },
        "url": { "type": "string" },
        "httpMethod": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "approver": { "type": "string" },
        "message": { "type": "string" },
        "timeout": { "type": "string" },
        "duration": { "type": "string" }
      }
    },
    "workflowTrigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "filter", "emoji", "cron", "interval"],
      "properties": {
        "kind": {
          "enum": [
            "message_posted", "reaction_added", "diff_posted", "schedule", "webhook"
          ]
        },
        "filter": { "type": "string" },
        "emoji": { "type": "string" },
        "cron": { "type": "string" },
        "interval": { "type": "string" }
      }
    },
    "workflowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "condition", "timeoutSecs", "action"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 64 },
        "name": { "type": "string" },
        "condition": { "type": "string", "maxLength": 4096 },
        "timeoutSecs": { "type": "integer", "minimum": 0 },
        "action": { "$ref": "#/$defs/workflowAction" }
      }
    },
    "workflowDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "trigger", "steps", "enabled"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "trigger": { "$ref": "#/$defs/workflowTrigger" },
        "steps": { "type": "array", "items": { "$ref": "#/$defs/workflowStep" } },
        "enabled": { "type": "boolean" }
      }
    },
    "workflowRunState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currentStep", "revision"],
      "properties": {
        "status": {
          "enum": [
            "pending", "running", "waiting_approval", "completed", "failed", "cancelled"
          ]
        },
        "currentStep": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "workflowPlanRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "state", "boundChannel", "trigger", "stepOutputs"],
      "properties": {
        "definition": { "$ref": "#/$defs/workflowDefinition" },
        "state": { "$ref": "#/$defs/workflowRunState" },
        "boundChannel": { "type": "string" },
        "trigger": { "$ref": "#/$defs/workflowValueMap" },
        "stepOutputs": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/workflowValueMap" }
        }
      }
    },
    "workflowTransitionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state", "expectedRevision", "transitionId", "transitionAlreadyApplied",
        "command", "stepCount", "stepIndex"
      ],
      "properties": {
        "state": { "$ref": "#/$defs/workflowRunState" },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "transitionId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "transitionAlreadyApplied": { "type": "boolean" },
        "command": {
          "enum": [
            "start", "skip_step", "effect_completed", "await_approval",
            "resume", "complete", "fail", "cancel"
          ]
        },
        "stepCount": { "type": "integer", "minimum": 0 },
        "stepIndex": { "type": "integer", "minimum": 0 }
      }
    },
    "workflowPolicyPayload": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "definition"],
          "properties": {
            "decision": { "const": "definition" },
            "definition": { "$ref": "#/$defs/workflowDefinition" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "expression", "values"],
          "properties": {
            "decision": { "const": "condition" },
            "expression": { "type": "string", "maxLength": 4096 },
            "values": { "$ref": "#/$defs/workflowValueMap" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "plan" },
            "request": { "$ref": "#/$defs/workflowPlanRequest" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "request"],
          "properties": {
            "decision": { "const": "transition" },
            "request": { "$ref": "#/$defs/workflowTransitionRequest" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "system.hello" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schemaHash",
            "workerRole",
            "maxFrameBytes",
            "maxInflight"
          ],
          "properties": {
            "schemaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "workerRole": { "const": "nimino-core" },
            "maxFrameBytes": { "const": 1048576 },
            "maxInflight": { "const": 1 }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "boundary.echo" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data"],
          "properties": { "data": {} }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.event.policy" },
        "payload": { "$ref": "#/$defs/eventPolicyPayload" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.community.policy" },
        "payload": { "$ref": "#/$defs/communityPolicyPayload" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.membership.policy" },
        "payload": { "$ref": "#/$defs/membershipPolicyPayload" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.dm.policy" },
        "payload": { "$ref": "#/$defs/dmPolicyPayload" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.moderation.policy" },
        "payload": { "$ref": "#/$defs/moderationPolicyPayload" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "version", "requestId", "operation", "payload"],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.workflow.policy" },
        "payload": { "$ref": "#/$defs/workflowPolicyPayload" }
      }
    }
  ]
}
