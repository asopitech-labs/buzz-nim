{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asopitech.com/nimino/contracts/nim-rust-boundary/v1/response.schema.json",
  "title": "NiminoBoundaryResponseV1",
  "$defs": {
    "policyError": {
      "enum": [
        "none",
        "unsupported_kind",
        "auth_not_storable",
        "d_tag_required",
        "d_tag_cardinality",
        "d_tag_too_long",
        "thread_parent_missing",
        "thread_parent_mismatch",
        "thread_channel_mismatch",
        "thread_root_mismatch",
        "thread_depth_exceeded",
        "delete_target_cardinality",
        "delete_target_missing",
        "delete_target_mismatch",
        "delete_author_mismatch",
        "delete_coordinate_invalid",
        "reaction_target_missing",
        "reaction_emoji_invalid"
      ]
    },
    "threadPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "parentId",
        "rootCreatedAt",
        "parentCreatedAt",
        "depth",
        "broadcast",
        "parentReplyDelta",
        "rootDescendantDelta"
      ],
      "properties": {
        "rootId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "parentId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "rootCreatedAt": { "type": "integer" },
        "parentCreatedAt": { "type": "integer" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 100 },
        "broadcast": { "type": "boolean" },
        "parentReplyDelta": { "const": 1 },
        "rootDescendantDelta": { "const": 1 }
      }
    },
    "eventPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "disposition", "error"],
          "properties": {
            "decision": { "const": "classify" },
            "disposition": {
              "enum": [
                "rejected",
                "stored",
                "ephemeral",
                "replaceable",
                "parameterized"
              ]
            },
            "error": { "$ref": "#/$defs/policyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action"],
          "properties": {
            "decision": { "const": "replacement" },
            "action": { "enum": ["insert", "replace", "duplicate", "stale"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "error", "plan"],
          "properties": {
            "decision": { "const": "thread" },
            "error": { "$ref": "#/$defs/policyError" },
            "plan": {
              "oneOf": [{ "$ref": "#/$defs/threadPlan" }, { "type": "null" }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "error",
            "action",
            "parentReplyDelta",
            "rootDescendantDelta"
          ],
          "properties": {
            "decision": { "const": "deletion" },
            "error": { "$ref": "#/$defs/policyError" },
            "action": {
              "enum": [
                "reject",
                "noop",
                "delete_event",
                "delete_coordinate",
                "keep_newer"
              ]
            },
            "parentReplyDelta": {
              "type": "integer",
              "minimum": -1,
              "maximum": 0
            },
            "rootDescendantDelta": {
              "type": "integer",
              "minimum": -1,
              "maximum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "error", "action", "emoji"],
          "properties": {
            "decision": { "const": "reaction" },
            "error": { "$ref": "#/$defs/policyError" },
            "action": { "enum": ["reject", "duplicate", "insert"] },
            "emoji": { "type": "string" }
          }
        }
      ]
    },
    "communityPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error"],
          "properties": {
            "decision": { "const": "lifecycle" },
            "action": {
              "enum": ["reject", "create", "archive", "unarchive", "noop"]
            },
            "error": {
              "enum": [
                "none",
                "not_operator",
                "not_owner",
                "owner_required",
                "owner_limit",
                "host_reserved",
                "protected_community",
                "invalid_state",
                "resource_missing",
                "tenant_mismatch"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "allowed", "error"],
          "properties": {
            "decision": { "const": "scope" },
            "allowed": { "type": "boolean" },
            "error": {
              "enum": ["none", "resource_missing", "tenant_mismatch"]
            }
          }
        }
      ]
    },
    "membershipPolicyError": {
      "enum": [
        "none",
        "not_operator",
        "not_authorized",
        "not_member",
        "invite_required",
        "role_invalid",
        "target_missing",
        "last_owner",
        "self_mutation",
        "owner_protected",
        "agent_add_denied",
        "invite_invalid",
        "invite_expired",
        "invite_exhausted",
        "policy_required",
        "mint_bounds",
        "owner_missing",
        "owner_conflict",
        "owner_limit"
      ]
    },
    "membershipAction": {
      "enum": [
        "reject",
        "insert",
        "update_role",
        "remove",
        "noop",
        "mint",
        "join",
        "transfer"
      ]
    },
    "membershipPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "channel" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "relay" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "invite" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "ownership_transfer" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        }
      ]
    },
    "membershipRole": {
      "enum": ["none", "owner", "admin", "member", "guest", "bot"]
    },
    "dmPolicyError": {
      "enum": [
        "none",
        "resource_missing",
        "tenant_mismatch",
        "not_dm",
        "not_participant",
        "actor_missing",
        "participant_count",
        "no_new_participant",
        "fact_conflict",
        "viewer_mismatch"
      ]
    },
    "dmPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error"],
          "properties": {
            "decision": { "const": "mutation" },
            "action": { "enum": ["reject", "create", "reuse", "unhide", "hide", "noop"] },
            "error": { "$ref": "#/$defs/dmPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "allowed", "error"],
          "properties": {
            "decision": { "const": "access" },
            "allowed": { "type": "boolean" },
            "error": { "$ref": "#/$defs/dmPolicyError" }
          }
        }
      ]
    },
    "moderationPolicyError": {
      "enum": [
        "none",
        "resource_missing",
        "tenant_mismatch",
        "fact_conflict",
        "actor_banned",
        "not_authorized",
        "protected_target",
        "self_target",
        "stale_command",
        "expiration_required",
        "expiration_elapsed",
        "duplicate",
        "not_banned",
        "not_timed_out",
        "report_closed",
        "resolution_pair"
      ]
    },
    "moderationEffect": {
      "enum": [
        "reject",
        "queue_report",
        "apply_ban",
        "lift_ban",
        "apply_timeout",
        "clear_timeout",
        "resolve_report",
        "allow",
        "deny_ban",
        "deny_timeout"
      ]
    },
    "moderationAuthority": {
      "enum": ["none", "reporter", "community_owner", "community_admin"]
    },
    "moderationAuditAction": {
      "enum": [
        "none",
        "ban",
        "unban",
        "timeout",
        "untimeout",
        "dismiss_report",
        "escalate",
        "resolve_delete",
        "resolve_kick",
        "resolve_ban",
        "resolve_timeout"
      ]
    },
    "moderationPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "report" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "restriction" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "resolution" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "enforcement" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        }
      ]
    },
    "clusterNodeState": {
      "enum": ["offline", "joining", "syncing", "ready", "draining"]
    },
    "clusterLifecycleEffect": {
      "enum": [
        "reject", "enter_joining", "enter_syncing", "enter_ready",
        "enter_draining", "enter_offline", "allow_lane", "deny_lane"
      ]
    },
    "clusterLifecycleError": {
      "enum": [
        "none", "unauthenticated", "revoked", "identity_conflict",
        "capability_mismatch", "control_version_mismatch",
        "data_version_mismatch", "invalid_transition",
        "transition_uncommitted", "sync_incomplete", "epoch_mismatch",
        "drain_incomplete", "lane_not_allowed", "fact_conflict"
      ]
    },
    "clusterLifecycleResult": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "effect", "nextState", "error"],
          "properties": {
            "decision": { "const": "transition" },
            "effect": { "$ref": "#/$defs/clusterLifecycleEffect" },
            "nextState": { "$ref": "#/$defs/clusterNodeState" },
            "error": { "$ref": "#/$defs/clusterLifecycleError" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "effect", "nextState", "error"],
          "properties": {
            "decision": { "const": "lane" },
            "effect": { "$ref": "#/$defs/clusterLifecycleEffect" },
            "nextState": { "$ref": "#/$defs/clusterNodeState" },
            "error": { "$ref": "#/$defs/clusterLifecycleError" }
          }
        }
      ]
    },
    "cliCommandError": { "enum": ["none", "unknown_command"] },
    "cliIoMode": { "enum": ["local", "relay_read", "relay_write"] },
    "cliPolicyOperation": {
      "enum": [
        "none", "domain.event.policy", "domain.community.policy",
        "domain.membership.policy", "domain.dm.policy",
        "domain.workflow.policy", "domain.moderation.policy"
      ]
    },
    "cliFailureCategory": {
      "enum": [
        "user_error", "relay_error", "network_error", "auth_error",
        "key_error", "conflict", "not_found", "delivery_unknown", "error"
      ]
    },
    "cliPolicyResult": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": [
            "decision", "accepted", "error", "ioMode", "requiresAuth",
            "outputContract", "policyOperation"
          ],
          "properties": {
            "decision": { "const": "command" },
            "accepted": { "type": "boolean" },
            "error": { "$ref": "#/$defs/cliCommandError" },
            "ioMode": { "$ref": "#/$defs/cliIoMode" },
            "requiresAuth": { "type": "boolean" },
            "outputContract": { "const": "nimino.cli-output/v1" },
            "policyOperation": { "$ref": "#/$defs/cliPolicyOperation" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "category", "exitCode", "retryable"],
          "properties": {
            "decision": { "const": "failure" },
            "category": { "$ref": "#/$defs/cliFailureCategory" },
            "exitCode": { "type": "integer", "minimum": 1, "maximum": 5 },
            "retryable": { "type": "boolean" }
          }
        }
      ]
    },
    "resolvedPersonaTriggers": {
      "type": "object", "additionalProperties": false,
      "required": ["mentions", "keywords", "allMessages"],
      "properties": {
        "mentions": {"type": "boolean"},
        "keywords": {"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}},
        "allMessages": {"type": "boolean"}
      }
    },
    "resolvedPersonaBehavior": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "temperature", "maxContextTokens", "subscribe", "triggers", "threadReplies", "broadcastReplies"],
      "properties": {
        "model": {"type": ["string", "null"], "maxLength": 4096},
        "temperature": {"type": ["number", "null"]},
        "maxContextTokens": {"type": ["integer", "null"], "minimum": 0},
        "subscribe": {"oneOf": [{"type": "array", "maxItems": 256, "items": {"type": "string", "maxLength": 4096}}, {"type": "null"}]},
        "triggers": {"oneOf": [{"$ref": "#/$defs/resolvedPersonaTriggers"}, {"type": "null"}]},
        "threadReplies": {"type": "boolean"},
        "broadcastReplies": {"type": "boolean"}
      }
    },
    "agentLifecycleState": {
      "type": "object", "additionalProperties": false,
      "required": ["phase", "attempt", "retryAtMs", "turnId"],
      "properties": {
        "phase": {"enum": ["absent", "starting", "ready", "running", "cancelling", "restart_wait", "stopped"]},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "retryAtMs": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "turnId": {"type": "string", "maxLength": 4096}
      }
    },
    "agentPolicyError": {"enum": ["none", "invalid_rule", "invalid_filter", "invalid_transition", "stale_attempt", "invalid_turn"]},
    "agentPolicyResult": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "behavior"],
          "properties": {"decision": {"const": "persona"}, "behavior": {"$ref": "#/$defs/resolvedPersonaBehavior"}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "matched", "ruleIndex", "promptTag", "error"],
          "properties": {
            "decision": {"const": "trigger"},
            "matched": {"type": "boolean"},
            "ruleIndex": {"type": "integer", "minimum": -1, "maximum": 255},
            "promptTag": {"type": "string", "maxLength": 4096},
            "error": {"$ref": "#/$defs/agentPolicyError"}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "allowed", "error", "action", "nextState"],
          "properties": {
            "decision": {"const": "lifecycle"},
            "allowed": {"type": "boolean"},
            "error": {"$ref": "#/$defs/agentPolicyError"},
            "action": {"enum": ["reject", "noop", "spawn", "accept_start", "begin_turn", "send_cancel", "return_ready", "reap_and_wait", "stop"]},
            "nextState": {"$ref": "#/$defs/agentLifecycleState"}
          }
        }
      ]
    },
    "workflowPolicyError": {
      "enum": [
        "none", "name_required", "steps_required", "invalid_step",
        "duplicate_step", "schedule_missing", "schedule_conflict",
        "invalid_schedule", "reply_requires_message", "invalid_trigger",
        "invalid_action", "definition_disabled", "invalid_condition",
        "unknown_variable", "type_mismatch", "invalid_template",
        "run_not_running", "invalid_step_index", "stale_revision",
        "duplicate_transition", "invalid_transition", "terminal_state",
        "invalid_transition_id"
      ]
    },
    "workflowAction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "text", "channel", "replyInThread", "recipient", "topic",
        "emoji", "url", "httpMethod", "headers", "body", "approver",
        "message", "timeout", "duration"
      ],
      "properties": {
        "kind": {
          "enum": [
            "send_message", "send_dm", "set_channel_topic", "add_reaction",
            "call_webhook", "request_approval", "delay"
          ]
        },
        "text": { "type": "string" },
        "channel": { "type": "string" },
        "replyInThread": { "type": "boolean" },
        "recipient": { "type": "string" },
        "topic": { "type": "string" },
        "emoji": { "type": "string" },
        "url": { "type": "string" },
        "httpMethod": { "type": "string" },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } },
        "body": { "type": "string" },
        "approver": { "type": "string" },
        "message": { "type": "string" },
        "timeout": { "type": "string" },
        "duration": { "type": "string" }
      }
    },
    "workflowRunState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "currentStep", "revision"],
      "properties": {
        "status": {
          "enum": [
            "pending", "running", "waiting_approval", "completed", "failed", "cancelled"
          ]
        },
        "currentStep": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 }
      }
    },
    "workflowPolicyResult": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "valid", "error", "requiresElevatedAuthority"],
          "properties": {
            "decision": { "const": "definition" },
            "valid": { "type": "boolean" },
            "error": { "$ref": "#/$defs/workflowPolicyError" },
            "requiresElevatedAuthority": { "type": "boolean" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "value", "error"],
          "properties": {
            "decision": { "const": "condition" },
            "value": { "type": "boolean" },
            "error": { "$ref": "#/$defs/workflowPolicyError" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "directive", "error", "stepId", "effect"],
          "properties": {
            "decision": { "const": "plan" },
            "directive": { "enum": ["reject", "execute_effect", "skip_step", "complete_run"] },
            "error": { "$ref": "#/$defs/workflowPolicyError" },
            "stepId": { "type": "string" },
            "effect": {
              "oneOf": [{ "$ref": "#/$defs/workflowAction" }, { "type": "null" }]
            }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["decision", "allowed", "error", "nextState", "portEffect"],
          "properties": {
            "decision": { "const": "transition" },
            "allowed": { "type": "boolean" },
            "error": { "$ref": "#/$defs/workflowPolicyError" },
            "nextState": { "$ref": "#/$defs/workflowRunState" },
            "portEffect": { "enum": ["none", "persist_transition"] }
          }
        }
      ]
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retry"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "CONTRACT_MISMATCH",
            "HANDSHAKE_REQUIRED",
            "UNKNOWN_OPERATION",
            "FRAME_TOO_LARGE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "maxLength": 1024 },
        "retry": { "enum": ["never", "idempotent_only", "after_refresh"] }
      },
      "oneOf": [
        {
          "properties": {
            "code": { "const": "INVALID_REQUEST" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "UNSUPPORTED_VERSION" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "CONTRACT_MISMATCH" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "HANDSHAKE_REQUIRED" },
            "retry": { "const": "after_refresh" }
          }
        },
        {
          "properties": {
            "code": { "const": "UNKNOWN_OPERATION" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "FRAME_TOO_LARGE" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "INTERNAL_ERROR" },
            "retry": { "const": "idempotent_only" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "system.hello" },
        "status": { "const": "ok" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workerVersion",
            "protocolVersion",
            "schemaHash",
