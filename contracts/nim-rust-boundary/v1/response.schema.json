{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://asopitech.com/nimino/contracts/nim-rust-boundary/v1/response.schema.json",
  "title": "NiminoBoundaryResponseV1",
  "$defs": {
    "policyError": {
      "enum": [
        "none",
        "unsupported_kind",
        "auth_not_storable",
        "d_tag_required",
        "d_tag_cardinality",
        "d_tag_too_long",
        "thread_parent_missing",
        "thread_parent_mismatch",
        "thread_channel_mismatch",
        "thread_root_mismatch",
        "thread_depth_exceeded",
        "delete_target_cardinality",
        "delete_target_missing",
        "delete_target_mismatch",
        "delete_author_mismatch",
        "delete_coordinate_invalid",
        "reaction_target_missing",
        "reaction_emoji_invalid"
      ]
    },
    "threadPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rootId",
        "parentId",
        "rootCreatedAt",
        "parentCreatedAt",
        "depth",
        "broadcast",
        "parentReplyDelta",
        "rootDescendantDelta"
      ],
      "properties": {
        "rootId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "parentId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "rootCreatedAt": { "type": "integer" },
        "parentCreatedAt": { "type": "integer" },
        "depth": { "type": "integer", "minimum": 1, "maximum": 100 },
        "broadcast": { "type": "boolean" },
        "parentReplyDelta": { "const": 1 },
        "rootDescendantDelta": { "const": 1 }
      }
    },
    "eventPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "disposition", "error"],
          "properties": {
            "decision": { "const": "classify" },
            "disposition": {
              "enum": [
                "rejected",
                "stored",
                "ephemeral",
                "replaceable",
                "parameterized"
              ]
            },
            "error": { "$ref": "#/$defs/policyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action"],
          "properties": {
            "decision": { "const": "replacement" },
            "action": { "enum": ["insert", "replace", "duplicate", "stale"] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "error", "plan"],
          "properties": {
            "decision": { "const": "thread" },
            "error": { "$ref": "#/$defs/policyError" },
            "plan": {
              "oneOf": [{ "$ref": "#/$defs/threadPlan" }, { "type": "null" }]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "decision",
            "error",
            "action",
            "parentReplyDelta",
            "rootDescendantDelta"
          ],
          "properties": {
            "decision": { "const": "deletion" },
            "error": { "$ref": "#/$defs/policyError" },
            "action": {
              "enum": [
                "reject",
                "noop",
                "delete_event",
                "delete_coordinate",
                "keep_newer"
              ]
            },
            "parentReplyDelta": {
              "type": "integer",
              "minimum": -1,
              "maximum": 0
            },
            "rootDescendantDelta": {
              "type": "integer",
              "minimum": -1,
              "maximum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "error", "action", "emoji"],
          "properties": {
            "decision": { "const": "reaction" },
            "error": { "$ref": "#/$defs/policyError" },
            "action": { "enum": ["reject", "duplicate", "insert"] },
            "emoji": { "type": "string" }
          }
        }
      ]
    },
    "communityPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error"],
          "properties": {
            "decision": { "const": "lifecycle" },
            "action": {
              "enum": ["reject", "create", "archive", "unarchive", "noop"]
            },
            "error": {
              "enum": [
                "none",
                "not_operator",
                "not_owner",
                "owner_required",
                "owner_limit",
                "host_reserved",
                "protected_community",
                "invalid_state",
                "resource_missing",
                "tenant_mismatch"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "allowed", "error"],
          "properties": {
            "decision": { "const": "scope" },
            "allowed": { "type": "boolean" },
            "error": {
              "enum": ["none", "resource_missing", "tenant_mismatch"]
            }
          }
        }
      ]
    },
    "membershipPolicyError": {
      "enum": [
        "none",
        "not_operator",
        "not_authorized",
        "not_member",
        "invite_required",
        "role_invalid",
        "target_missing",
        "last_owner",
        "self_mutation",
        "owner_protected",
        "agent_add_denied",
        "invite_invalid",
        "invite_expired",
        "invite_exhausted",
        "policy_required",
        "mint_bounds",
        "owner_missing",
        "owner_conflict",
        "owner_limit"
      ]
    },
    "membershipAction": {
      "enum": [
        "reject",
        "insert",
        "update_role",
        "remove",
        "noop",
        "mint",
        "join",
        "transfer"
      ]
    },
    "membershipPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "channel" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "relay" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "invite" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error", "effectiveRole"],
          "properties": {
            "decision": { "const": "ownership_transfer" },
            "action": { "$ref": "#/$defs/membershipAction" },
            "error": { "$ref": "#/$defs/membershipPolicyError" },
            "effectiveRole": { "$ref": "#/$defs/membershipRole" }
          }
        }
      ]
    },
    "membershipRole": {
      "enum": ["none", "owner", "admin", "member", "guest", "bot"]
    },
    "dmPolicyError": {
      "enum": [
        "none",
        "resource_missing",
        "tenant_mismatch",
        "not_dm",
        "not_participant",
        "actor_missing",
        "participant_count",
        "no_new_participant",
        "fact_conflict",
        "viewer_mismatch"
      ]
    },
    "dmPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "action", "error"],
          "properties": {
            "decision": { "const": "mutation" },
            "action": { "enum": ["reject", "create", "reuse", "unhide", "hide", "noop"] },
            "error": { "$ref": "#/$defs/dmPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "allowed", "error"],
          "properties": {
            "decision": { "const": "access" },
            "allowed": { "type": "boolean" },
            "error": { "$ref": "#/$defs/dmPolicyError" }
          }
        }
      ]
    },
    "moderationPolicyError": {
      "enum": [
        "none",
        "resource_missing",
        "tenant_mismatch",
        "fact_conflict",
        "actor_banned",
        "not_authorized",
        "protected_target",
        "self_target",
        "stale_command",
        "expiration_required",
        "expiration_elapsed",
        "duplicate",
        "not_banned",
        "not_timed_out",
        "report_closed",
        "resolution_pair"
      ]
    },
    "moderationEffect": {
      "enum": [
        "reject",
        "queue_report",
        "apply_ban",
        "lift_ban",
        "apply_timeout",
        "clear_timeout",
        "resolve_report",
        "allow",
        "deny_ban",
        "deny_timeout"
      ]
    },
    "moderationAuthority": {
      "enum": ["none", "reporter", "community_owner", "community_admin"]
    },
    "moderationAuditAction": {
      "enum": [
        "none",
        "ban",
        "unban",
        "timeout",
        "untimeout",
        "dismiss_report",
        "escalate",
        "resolve_delete",
        "resolve_kick",
        "resolve_ban",
        "resolve_timeout"
      ]
    },
    "moderationPolicyResult": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "report" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "restriction" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "resolution" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "effect", "authority", "auditAction", "error"],
          "properties": {
            "decision": { "const": "enforcement" },
            "effect": { "$ref": "#/$defs/moderationEffect" },
            "authority": { "$ref": "#/$defs/moderationAuthority" },
            "auditAction": { "$ref": "#/$defs/moderationAuditAction" },
            "error": { "$ref": "#/$defs/moderationPolicyError" }
          }
        }
      ]
    },
    "fault": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retry"],
      "properties": {
        "code": {
          "enum": [
            "INVALID_REQUEST",
            "UNSUPPORTED_VERSION",
            "CONTRACT_MISMATCH",
            "HANDSHAKE_REQUIRED",
            "UNKNOWN_OPERATION",
            "FRAME_TOO_LARGE",
            "INTERNAL_ERROR"
          ]
        },
        "message": { "type": "string", "maxLength": 1024 },
        "retry": { "enum": ["never", "idempotent_only", "after_refresh"] }
      },
      "oneOf": [
        {
          "properties": {
            "code": { "const": "INVALID_REQUEST" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "UNSUPPORTED_VERSION" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "CONTRACT_MISMATCH" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "HANDSHAKE_REQUIRED" },
            "retry": { "const": "after_refresh" }
          }
        },
        {
          "properties": {
            "code": { "const": "UNKNOWN_OPERATION" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "FRAME_TOO_LARGE" },
            "retry": { "const": "never" }
          }
        },
        {
          "properties": {
            "code": { "const": "INTERNAL_ERROR" },
            "retry": { "const": "idempotent_only" }
          }
        }
      ]
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "system.hello" },
        "status": { "const": "ok" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "workerVersion",
            "protocolVersion",
            "schemaHash",
            "workerRole",
            "maxFrameBytes",
            "maxInflight",
            "capabilities"
          ],
          "properties": {
            "workerVersion": { "type": "string", "minLength": 1 },
            "protocolVersion": { "const": 1 },
            "schemaHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "workerRole": { "const": "nimino-core" },
            "maxFrameBytes": { "const": 1048576 },
            "maxInflight": { "const": 1 },
            "capabilities": {
              "type": "array",
              "items": {
                "enum": [
                  "boundary.echo",
                  "domain.event.policy",
                  "domain.community.policy",
                  "domain.membership.policy",
                  "domain.dm.policy",
                  "domain.moderation.policy"
                ]
              },
              "contains": { "const": "domain.event.policy" }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "boundary.echo" },
        "status": { "const": "ok" },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["data"],
          "properties": { "data": {} }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.event.policy" },
        "status": { "const": "ok" },
        "result": { "$ref": "#/$defs/eventPolicyResult" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.community.policy" },
        "status": { "const": "ok" },
        "result": { "$ref": "#/$defs/communityPolicyResult" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.membership.policy" },
        "status": { "const": "ok" },
        "result": { "$ref": "#/$defs/membershipPolicyResult" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.dm.policy" },
        "status": { "const": "ok" },
        "result": { "$ref": "#/$defs/dmPolicyResult" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "result"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "const": "domain.moderation.policy" },
        "status": { "const": "ok" },
        "result": { "$ref": "#/$defs/moderationPolicyResult" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "version",
        "requestId",
        "operation",
        "status",
        "error"
      ],
      "properties": {
        "protocol": { "const": "nimino.core.boundary" },
        "version": { "const": 1 },
        "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "operation": { "type": "string", "minLength": 1, "maxLength": 128 },
        "status": { "const": "error" },
        "error": { "$ref": "#/$defs/fault" }
      }
    }
  ]
}
